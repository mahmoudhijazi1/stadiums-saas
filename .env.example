# Local Docker Postgres (see docker-compose.yml). Copy to .env and adjust if needed.
# Host port 5433 → container 5432 (avoids clashing with other local Postgres on 5432).
# Inspect with DBeaver at localhost:5433 — user stadiums_local / stadiums_local_dev.

DATABASE_URL="postgresql://stadiums_local:stadiums_local_dev@localhost:5433/stadiums_dev?schema=public"
DATABASE_URL_TEST="postgresql://stadiums_local:stadiums_local_dev@localhost:5433/stadiums_test?schema=public"
