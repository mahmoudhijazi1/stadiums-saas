# Local Docker Postgres (see docker-compose.yml). Copy to .env and adjust if needed.
# Host port 5433 → container 5432 (avoids clashing with other local Postgres on 5432).
# Inspect with DBeaver at localhost:5433 — user stadiums_local / stadiums_local_dev.

DATABASE_URL="postgresql://stadiums_local:stadiums_local_dev@localhost:5433/stadiums_dev?schema=public"
DATABASE_URL_TEST="postgresql://stadiums_local:stadiums_local_dev@localhost:5433/stadiums_test?schema=public"

# Public links in messages: ${APP_PROTOCOL}://${slug}.${APP_BASE_DOMAIN}/
# Local tenant ahmad → http://ahmad.localhost:3000/
# Production: APP_BASE_DOMAIN=lebstads.com and APP_PROTOCOL=https (https is the code default).
APP_BASE_DOMAIN="localhost:3000"
APP_PROTOCOL="http"

# Per-IP rate limits (security audit S-3). Leave unset unless the reverse proxy
# overwrites this header with the real client address (nginx:
# proxy_set_header X-Real-IP $remote_addr;). Unset = no per-IP limits.
# TRUSTED_CLIENT_IP_HEADER="x-real-ip"

# Password hash cost: scrypt N = 2^cost, 14..20. Default 16 (about 190 ms and
# 64 MB per hash on a 4-core machine). Lower it if login is slow on the server;
# existing hashes are upgraded or downgraded on each user's next login.
# PASSWORD_HASH_COST=16

# Honor X-Forwarded-Host only behind our own reverse proxy that sets it
# (nginx: proxy_set_header X-Forwarded-Host $host;). Default: Host only.
# TRUST_PROXY_HEADERS="true"
