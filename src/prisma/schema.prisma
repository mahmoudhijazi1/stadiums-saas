// Prisma schema = the blueprint of your database tables.
// Prisma reads this file and can create/update real Postgres tables from it.

generator client {
  // Generates TypeScript code so our app can query the DB safely
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL is in prisma7.config.ts (Prisma 7 style), not here
}

/// One stadium business (e.g. slug "ahmad" from ahmad.stadiums.com)
model Tenant {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  /// Per-stadium knobs (DR-002 §2.6). Zod at app edge. Default {}.
  settings            Json                 @default("{}")
  createdAt           DateTime             @default(now())
  pitches             Pitch[]
  persons             Person[]
  bookings            Booking[]
  bookingParticipants BookingParticipant[]
  slotInterests       SlotInterest[]
  memberships         Membership[]
  userPersonLinks     UserPersonLink[]
  exchangeRates       ExchangeRate[]
  payments            Payment[]
  paymentTenders      PaymentTender[]
  paymentAllocations  PaymentAllocation[]
  ledgerEntries       LedgerEntry[]
  expenses            Expense[]
  bookingDueChanges   BookingDueChange[]
  products            Product[]
  sales               Sale[]
  saleItems           SaleItem[]
  saleAllocations     SaleAllocation[]
  pushSubscriptions   PushSubscription[]
  bookingSeries       BookingSeries[]
  /// Set by the platform operator (scripts/platform.ts). Null = active. Sessions and
  /// data are untouched; resume clears both columns (decision 7).
  suspendedAt         DateTime?
  /// Operator note only. Never shown to owners or players.
  suspendedReason     String?
  subscriptions       Subscription[]
  platformAuditLogs   PlatformAuditLog[]
}

/// A pitch/field that belongs to exactly one tenant (tenantId is required)
model Pitch {
  id                 String          @id @default(cuid())
  tenantId           String
  name               String
  /// Opening hours, slot length, gaps, pricing (DR-002 §2.4). Zod-validated in app code, not here.
  /// Default is a closed week so existing rows are valid jsonb (SPEC-02 step 1).
  scheduleConfig     Json            @default("{ \"slotDurationMinutes\": 60, \"gapMinutes\": 0, \"hours\": { \"mon\": [], \"tue\": [], \"wed\": [], \"thu\": [], \"fri\": [], \"sat\": [], \"sun\": [] }, \"defaultPriceUsd\": \"0.00\", \"priceRules\": [] }")
  /// Players expected per game; the default count when a booking is split per player (SPEC-15 P2).
  /// CHECK ("defaultPlayerCount" BETWEEN 1 AND 30) is SQL-only (Pitch_defaultPlayerCount_range).
  defaultPlayerCount Int             @default(10)
  createdAt          DateTime        @default(now())
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  bookings           Booking[]
  slotInterests      SlotInterest[]
  bookingSeries      BookingSeries[]

  @@index([tenantId])
}

/// Name + phone at one stadium. Same phone at two stadiums = two rows (DR-002 §2.2 / RULE-8).
model Person {
  id                  String               @id @default(cuid())
  tenantId            String
  name                String
  /// Null until a phone is known. Prisma cannot declare a partial unique index.
  /// SQL: unique ("tenantId", "phone") WHERE "phone" IS NOT NULL
  /// — index Person_tenantId_phone_key in 20260924060000_per_player_foundation.
  phone               String?
  /// Folded by normalizeName on every create. Backfill is in the migration SQL.
  searchName          String
  createdAt           DateTime             @default(now())
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  bookingParticipants BookingParticipant[]
  userPersonLinks     UserPersonLink[]
  slotInterests       SlotInterest[]
  /// Shop tabs this person owes (Sale.payerPersonId).
  shopTabs            Sale[]
  bookingSeries       BookingSeries[]

  @@index([tenantId])
  @@index([tenantId, searchName])
}

/// A pitch + a UTC window. People attach through BookingParticipant, not here (DR-002 §2.9).
model Booking {
  id             String                   @id @default(cuid())
  tenantId       String
  pitchId        String
  /// Postgres tstzrange. Prisma 7 has no range scalar — Unsupported, not in Client (v7 Unsupported docs).
  during         Unsupported("tstzrange")
  status         BookingStatus
  source         BookingSource
  /// WHOLE puts the booking remaining on the requester. PER_PLAYER is later (SPEC-15).
  collectionMode CollectionMode           @default(WHOLE)
  /// Snapshot of the slot price at request time (DR-002 §2.18). Never a float.
  priceUsd       Decimal                  @db.Decimal(12, 2)
  /// What collection still uses. Starts equal to priceUsd. Independent after a split (SPEC-15).
  /// CHECK ("amountDueUsd" >= 0) is SQL-only (Booking_amountDueUsd_nonneg).
  amountDueUsd   Decimal                  @db.Decimal(12, 2)
  requestedAt    DateTime                 @default(now())
  /// Public request only: the name as typed (cleaned) when its normalizeName fold differs
  /// from the stored Person name. The Person name is never overwritten (security audit S-6).
  requestedName  String?
  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  pitch          Pitch                    @relation(fields: [pitchId], references: [id])
  participants   BookingParticipant[]
  dueChanges     BookingDueChange[]
  /// Items put on this game: one tab per payer (the booker's included).
  sales          Sale[]
  /// The weekly series this game belongs to, if any. A series is only the link (BookingSeries).
  seriesId       String?
  series         BookingSeries?           @relation(fields: [seriesId], references: [id])

  @@index([tenantId])
  @@index([seriesId])
}

/// Who is on a booking. The public requester is a row with isRequester (DR-002 §2.10).
model BookingParticipant {
  id           String              @id @default(cuid())
  tenantId     String
  bookingId    String
  /// Null while a per-player slot has no person yet. Callers that pass a phone still set it.
  /// A requester cannot be null:
  /// CHECK ("isRequester" = false OR "personId" IS NOT NULL) is SQL-only
  /// (BookingParticipant_requester_has_person).
  personId     String?
  /// CHECK ("amountDueUsd" >= 0) is SQL-only (BookingParticipant_amountDueUsd_nonneg).
  amountDueUsd Decimal             @db.Decimal(12, 2)
  /// 1-based share order for an even split. Null on WHOLE.
  /// At most one row per booking when set: partial unique
  /// BookingParticipant_bookingId_slotNumber_not_null_key
  /// ("bookingId", "slotNumber") WHERE "slotNumber" IS NOT NULL.
  /// Prisma cannot declare that WHERE. The plain index is @@index below.
  slotNumber   Int?
  /// At most one true row per booking. Enforced by SQL partial unique
  /// BookingParticipant_one_requester_idx ("bookingId") WHERE "isRequester" = true.
  /// Prisma cannot declare that WHERE.
  isRequester  Boolean
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  booking      Booking             @relation(fields: [bookingId], references: [id])
  person       Person?             @relation(fields: [personId], references: [id])
  allocations  PaymentAllocation[]

  @@index([tenantId])
  @@index([tenantId, personId])
  @@index([bookingId, slotNumber])
}

/// Waitlist window (DR-002 §2.13). Written on auto-reject (SPEC-05). No UI this slice.
model SlotInterest {
  id        String                   @id @default(cuid())
  tenantId  String
  pitchId   String
  /// Same tstzrange as Booking. Stores the *approved* window, not a rejected booking id.
  during    Unsupported("tstzrange")
  personId  String
  createdAt DateTime                 @default(now())
  tenant    Tenant                   @relation(fields: [tenantId], references: [id])
  pitch     Pitch                    @relation(fields: [pitchId], references: [id])
  person    Person                   @relation(fields: [personId], references: [id])

  @@index([tenantId])
}

/// DR-002 §2.8 / §2.12. PENDING may overlap; only APPROVED will hit the exclusion (step 2).
enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  OWNER
  PUBLIC
}

/// How a booking's USD due is owed (SPEC-15). Existing rows are WHOLE.
enum CollectionMode {
  WHOLE
  PER_PLAYER
}

/// Why Booking.amountDueUsd changed (SPEC-16). Append-only.
enum BookingDueReason {
  LATE_CANCELLATION_FEE
  NO_SHOW_FEE
  CANCELLATION_NO_FEE
  PARTIAL_GAME
  DISCOUNT
  WAIVER
  CORRECTION
  /// 30 minutes added to a confirmed game (src/modules/booking/application/extend-booking.ts).
  EXTENSION
  /// UNUSED. Slice 2 wrote it for items added to the booking due; "on the game" is now the booker's tab
  /// and nothing writes it. Postgres cannot drop an enum value, so it stays (docs/DATA-MODEL.md).
  SHOP_ITEMS
}

/// One change of what is collectible. Never updated or deleted.
/// CHECK ("fromUsd" >= 0 AND "toUsd" >= 0) is SQL-only (BookingDueChange_usd_nonneg).
model BookingDueChange {
  id                String           @id @default(cuid())
  tenantId          String
  bookingId         String
  fromUsd           Decimal          @db.Decimal(12, 2)
  toUsd             Decimal          @db.Decimal(12, 2)
  reason            BookingDueReason
  note              String?
  actorMembershipId String
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  booking           Booking          @relation(fields: [bookingId], references: [id])
  actorMembership   Membership       @relation(fields: [actorMembershipId], references: [id])

  @@index([tenantId, bookingId])
}

/// Login account. No tenantId — memberships attach a user to a stadium (DR-003 §3).
model User {
  id                String             @id @default(cuid())
  identifier        String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  memberships       Membership[]
  sessions          Session[]
  personLinks       UserPersonLink[]
  pushSubscriptions PushSubscription[]
}

/// This user may work at this stadium. tenantId required (DR-001). Unique per tenant+user.
model Membership {
  id            String             @id @default(cuid())
  tenantId      String
  userId        String
  role          MembershipRole
  /// Zod-validated at the app edge (DR-003 §5). Default empty = staff has no extra flags.
  permissions   Json               @default("{}")
  createdAt     DateTime           @default(now())
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
  dueChanges    BookingDueChange[]
  sales         Sale[]
  bookingSeries BookingSeries[]

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Server-side session. No tenantId — cookie is not the isolation key (DR-003 §4).
model Session {
  id                String             @id @default(cuid())
  /// SHA-256 (hex) of the cookie token. The raw token is never stored (security audit S-2).
  tokenHash         String             @unique
  userId            String
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id])
  /// Back-relation only (no column): a session's push subscriptions go with it (ON DELETE CASCADE).
  pushSubscriptions PushSubscription[]

  @@index([userId])
}

/// Optional account↔person. Empty this slice (DR-002 §2.1 / DR-003 §6). tenantId required.
model UserPersonLink {
  id       String             @id @default(cuid())
  tenantId String
  userId   String
  personId String
  relation PersonLinkRelation
  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  user     User               @relation(fields: [userId], references: [id])
  person   Person             @relation(fields: [personId], references: [id])

  @@index([tenantId])
}

enum MembershipRole {
  OWNER
  STAFF
}

enum PersonLinkRelation {
  SELF
  GUARDIAN
}

/// Current and past LBP-per-USD rates. Append-only (DR-002 §2.17). tenantId required.
model ExchangeRate {
  id        String   @id @default(cuid())
  tenantId  String
  lbpPerUsd Decimal  @db.Decimal(18, 0)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// One collection event. Links to a booking by sourceType+sourceId — no booking_id (DR-002 §2.14).
model Payment {
  id           String              @id @default(cuid())
  tenantId     String
  sourceType   PaymentSourceType
  sourceId     String
  /// Booking: Booking.amountDueUsd at collection. Expense: this payment’s USD-equivalent sum (SPEC-06 / SPEC-07).
  amountDueUsd Decimal             @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  tenders      PaymentTender[]
  allocations  PaymentAllocation[]

  @@index([tenantId])
  @@index([sourceType, sourceId])
}

/// USD from one payment assigned to one participant. No person column on Payment (DR-002 §2.14).
/// CHECK ("amountUsd" > 0) is SQL-only (PaymentAllocation_amountUsd_positive).
model PaymentAllocation {
  id            String             @id @default(cuid())
  tenantId      String
  paymentId     String
  participantId String
  amountUsd     Decimal            @db.Decimal(12, 2)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment       Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  participant   BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([paymentId, participantId])
  @@index([tenantId])
  @@index([paymentId])
  @@index([participantId])
}

/// One cash part of a payment. amount is Decimal(18,2); domain enforces USD cents vs integer LBP (SPEC-06).
model PaymentTender {
  id            String   @id @default(cuid())
  tenantId      String
  paymentId     String
  currency      Currency
  amount        Decimal  @db.Decimal(18, 2)
  /// Frozen rate. Null on USD when no rate existed (SPEC-06).
  rateAtTime    Decimal? @db.Decimal(18, 0)
  usdEquivalent Decimal  @db.Decimal(12, 2)
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  payment       Payment  @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
}

/// USD movement, append-only. Same source as the payment; written in the same tx (DR-002 §2.21).
model LedgerEntry {
  id         String            @id @default(cuid())
  tenantId   String
  direction  LedgerDirection
  amountUsd  Decimal           @db.Decimal(12, 2)
  occurredAt DateTime          @default(now())
  sourceType PaymentSourceType
  sourceId   String
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, occurredAt])
}

/// What was spent. No amount — money is a Payment with sourceType EXPENSE (DR-002 §2.22).
model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  category    ExpenseCategory
  description String
  occurredAt  DateTime
  createdAt   DateTime        @default(now())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, occurredAt])
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  MAINTENANCE
  SALARY
  EQUIPMENT
  OTHER
  SHOP_SUPPLIES
}

/// Polymorphic source. BOOKING | EXPENSE | SALE (DR-002 §2.14). A walk-in shop sale is SALE.
enum PaymentSourceType {
  BOOKING
  EXPENSE
  SALE
}

/// Something the stadium sells at the counter. Archived, never deleted: past sales keep it.
/// A price edit changes future sales only (SaleItem freezes the price).
/// CHECK ("priceUsd" > 0) is SQL-only (Product_priceUsd_positive).
model Product {
  id            String     @id @default(cuid())
  tenantId      String
  name          String
  /// Which currency the price tag is in. A USD item has priceUsd, an LBP item has priceLbp (whole
  /// pounds); exactly one is set. CHECK Product_price_by_currency (SQL-only) enforces it.
  priceCurrency Currency   @default(USD)
  priceUsd      Decimal?   @db.Decimal(12, 2)
  priceLbp      BigInt?
  archivedAt    DateTime?
  createdAt     DateTime   @default(now())
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  saleItems     SaleItem[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
}

/// One counter sale. Insert-only (no code path updates or deletes it) and with NO stored total:
/// the total is the sum of its lines, what was paid is the sum of the payments of sourceType SALE
/// with this id (DR-002 §2.14).
model Sale {
  id                    String           @id @default(cuid())
  tenantId              String
  soldAt                DateTime         @default(now())
  createdByMembershipId String
  /// Set when the items were put on a game (slice 2). Null = a walk-in sale.
  bookingId             String?
  /// A player's tab on that game: a person (the booker's included: "On the game (booker)"), or a typed
  /// name (with an optional phone) when there is no person. A sale on a booking always has a payer;
  /// both are null only on a walk-in sale. A tab never changes the booking due or a slot due.
  /// CHECKs and partial uniques are SQL-only (Sale_payer_needs_booking, Sale_booking_needs_payer,
  /// Sale_payer_one_identity, Sale_payerName_not_blank, Sale_payerPhone_needs_name;
  /// Sale_booking_payer_person_key, Sale_booking_payer_name_key).
  payerPersonId         String?
  payerName             String?
  payerPhone            String?
  createdAt             DateTime         @default(now())
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  createdBy             Membership       @relation(fields: [createdByMembershipId], references: [id])
  booking               Booking?         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payer                 Person?          @relation(fields: [payerPersonId], references: [id], onDelete: Restrict)
  items                 SaleItem[]
  allocations           SaleAllocation[]

  @@index([tenantId])
  @@index([tenantId, soldAt])
  @@index([bookingId])
  @@index([payerPersonId])
}

/// A line of a sale, with the unit price frozen at sale time. Insert-only.
/// A removal is a second line with a NEGATIVE qty that names the line it reverses (`reversesItemId`),
/// so nothing is ever updated or deleted. Only the remove use case writes one.
/// CHECK (qty BETWEEN -99 AND 99 AND qty <> 0, "unitPriceUsd" > 0, "lineTotalUsd" = qty * "unitPriceUsd",
/// qty > 0 exactly when reversesItemId is null) is SQL-only (SaleItem_qty_range, SaleItem_unitPriceUsd_positive,
/// SaleItem_lineTotal_matches, SaleItem_reversal_sign). A trigger checks that a reversal names a positive
/// line of the same sale, item and price and never takes the net quantity below zero.
model SaleItem {
  id             String     @id @default(cuid())
  tenantId       String
  saleId         String
  productId      String
  qty            Int
  /// Frozen USD value, for every report. A USD item: its price. An LBP item: the LBP price converted at
  /// `rateAtTime` with the shared tender conversion (can round to 0.00 for a tiny price).
  unitPriceUsd   Decimal    @db.Decimal(12, 2)
  /// A USD item: qty x unit price. An LBP item: the conversion of `lineTotalLbp` (a removal's line
  /// carries the difference, so the lines of one item always add up to the conversion of the net LBP).
  lineTotalUsd   Decimal    @db.Decimal(12, 2)
  /// LBP items only (all three set together, CHECK SaleItem_lbp_fields_together): the price tag in
  /// pounds, qty x that, and the LBP-per-USD rate it was frozen at.
  unitPriceLbp   Decimal?   @db.Decimal(18, 0)
  lineTotalLbp   Decimal?   @db.Decimal(18, 0)
  rateAtTime     Decimal?   @db.Decimal(18, 0)
  /// When the line was added: the Shop card counts by it (a line added to a game's tab tomorrow
  /// belongs to tomorrow). Equal to the sale time on a walk-in sale.
  addedAt        DateTime   @default(now())
  reversesItemId String?
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  sale           Sale       @relation(fields: [saleId], references: [id])
  product        Product    @relation(fields: [productId], references: [id])
  reverses       SaleItem?  @relation("SaleItemReversal", fields: [reversesItemId], references: [id], onDelete: Restrict)
  reversedBy     SaleItem[] @relation("SaleItemReversal")

  @@index([tenantId])
  @@index([saleId])
  @@index([tenantId, productId])
  @@index([tenantId, addedAt])
  @@index([reversesItemId])
}

/// How much of a sale's LBP part and USD part one payment settled. Insert-only, one row per payment.
/// What a sale still owes in LBP is the sum of its LBP lines minus the sum of `lbpApplied` (likewise
/// USD), so a rate change never changes what is owed in pounds. `paymentId` has no foreign key
/// (Payment does not know what a source is, DR-002 §2.14).
model SaleAllocation {
  id         String   @id @default(cuid())
  tenantId   String
  saleId     String
  paymentId  String   @unique
  lbpApplied Decimal  @db.Decimal(18, 0)
  usdApplied Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  sale       Sale     @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([saleId])
}

enum Currency {
  USD
  LBP
}

/// IN = collect; OUT = expense (SPEC-07). Append-only (DR-002 §2.21).
enum LedgerDirection {
  IN
  OUT
}

/// Rate-limit counter (security audit S-3). One row per key; the window restarts
/// at the first hit after it ends. Global like Session: the key carries the
/// account, IP or tenant it counts. Written only by src/lib/rate-limit.ts.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
}

/// Platform-only (never through the scoped client). Append-only: a trigger blocks
/// UPDATE and DELETE. The latest row by createdAt is the current plan. Plan is a
/// label only: no limits, no pricing (BR-103 partial by decision).
model Subscription {
  id         String    @id @default(cuid())
  tenantId   String
  plan       String
  startsAt   DateTime
  /// Informational: the list flags OVERDUE. Nothing blocks on it (decision 2).
  paidUntil  DateTime?
  amountUsd  Decimal?  @db.Decimal(12, 2)
  note       String?
  /// Actor string as given by the use case ("cli:user@host").
  recordedBy String
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

/// Platform-only, append-only (trigger blocks UPDATE and DELETE). One row per
/// mutating platform command, written in the same transaction. Never a password.
model PlatformAuditLog {
  id        String   @id @default(cuid())
  action    String
  tenantId  String?
  actor     String
  detail    Json     @default("{}")
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
}

/// One browser on one device that may receive owner alerts (web push). tenantId required (DR-001).
/// Tied to the login session that created it: deleting the session (logout, log out other devices,
/// password change, expiry cleanup) deletes the subscription (ON DELETE CASCADE). endpoint is
/// globally unique: one browser belongs to one user and tenant at a time, and a new login on the
/// same phone takes it over (src/modules/push). Written by raw upsert (ON CONFLICT (endpoint)).
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  sessionId String
  /// The push service URL, validated against an allowlist before it is stored (SSRF).
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("ar")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([sessionId])
  @@index([userId, createdAt])
}

/// A weekly recurring booking: the link between ordinary APPROVED bookings that are all created up
/// front (Booking.seriesId). No background job, no virtual bookings. Week k starts at the anchor's
/// local wall-clock time (Asia/Beirut) on anchorDate + 7k days. tenantId required (DR-001).
model BookingSeries {
  id                    String     @id @default(cuid())
  tenantId              String
  pitchId               String
  personId              String
  /// Local date of week 0, and its local time "HH:mm".
  anchorDate            DateTime   @db.Date
  anchorTime            String     @db.VarChar(5)
  durationMinutes       Int
  createdByMembershipId String
  createdAt             DateTime   @default(now())
  tenant                Tenant     @relation(fields: [tenantId], references: [id])
  pitch                 Pitch      @relation(fields: [pitchId], references: [id])
  person                Person     @relation(fields: [personId], references: [id])
  createdBy             Membership @relation(fields: [createdByMembershipId], references: [id])
  bookings              Booking[]

  @@index([tenantId])
  @@index([pitchId])
  @@index([personId])
}
