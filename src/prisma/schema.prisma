// Prisma schema = the blueprint of your database tables.
// Prisma reads this file and can create/update real Postgres tables from it.

generator client {
  // Generates TypeScript code so our app can query the DB safely
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL is in prisma7.config.ts (Prisma 7 style), not here
}

/// One stadium business (e.g. slug "ahmad" from ahmad.stadiums.com)
model Tenant {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  /// Per-stadium knobs (DR-002 §2.6). Zod at app edge. Default {}.
  settings            Json                 @default("{}")
  createdAt           DateTime             @default(now())
  pitches             Pitch[]
  persons             Person[]
  bookings            Booking[]
  bookingParticipants BookingParticipant[]
  slotInterests       SlotInterest[]
  memberships         Membership[]
  userPersonLinks     UserPersonLink[]
  exchangeRates       ExchangeRate[]
  payments            Payment[]
  paymentTenders      PaymentTender[]
  paymentAllocations  PaymentAllocation[]
  ledgerEntries       LedgerEntry[]
  expenses            Expense[]
  bookingDueChanges   BookingDueChange[]
}

/// A pitch/field that belongs to exactly one tenant (tenantId is required)
model Pitch {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  /// Opening hours, slot length, gaps, pricing (DR-002 §2.4). Zod-validated in app code, not here.
  /// Default is a closed week so existing rows are valid jsonb (SPEC-02 step 1).
  scheduleConfig Json      @default("{ \"slotDurationMinutes\": 60, \"gapMinutes\": 0, \"hours\": { \"mon\": [], \"tue\": [], \"wed\": [], \"thu\": [], \"fri\": [], \"sat\": [], \"sun\": [] }, \"defaultPriceUsd\": \"0.00\", \"priceRules\": [] }")
  createdAt      DateTime  @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  bookings       Booking[]
  slotInterests  SlotInterest[]

  @@index([tenantId])
}

/// Name + phone at one stadium. Same phone at two stadiums = two rows (DR-002 §2.2 / RULE-8).
model Person {
  id                  String               @id @default(cuid())
  tenantId            String
  name                String
  /// Null until a phone is known. Prisma cannot declare a partial unique index.
  /// SQL: unique ("tenantId", "phone") WHERE "phone" IS NOT NULL
  /// — index Person_tenantId_phone_key in 20260924060000_per_player_foundation.
  phone               String?
  /// Folded by normalizeName on every create. Backfill is in the migration SQL.
  searchName          String
  createdAt           DateTime             @default(now())
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  bookingParticipants BookingParticipant[]
  userPersonLinks     UserPersonLink[]
  slotInterests       SlotInterest[]

  @@index([tenantId])
  @@index([tenantId, searchName])
}

/// A pitch + a UTC window. People attach through BookingParticipant, not here (DR-002 §2.9).
model Booking {
  id           String                   @id @default(cuid())
  tenantId     String
  pitchId      String
  /// Postgres tstzrange. Prisma 7 has no range scalar — Unsupported, not in Client (v7 Unsupported docs).
  during       Unsupported("tstzrange")
  status       BookingStatus
  source       BookingSource
  /// WHOLE puts the booking remaining on the requester. PER_PLAYER is later (SPEC-15).
  collectionMode CollectionMode         @default(WHOLE)
  /// Snapshot of the slot price at request time (DR-002 §2.18). Never a float.
  priceUsd     Decimal                  @db.Decimal(12, 2)
  /// What collection still uses. Starts equal to priceUsd. Independent after a split (SPEC-15).
  /// CHECK ("amountDueUsd" >= 0) is SQL-only (Booking_amountDueUsd_nonneg).
  amountDueUsd Decimal                  @db.Decimal(12, 2)
  requestedAt  DateTime                 @default(now())
  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  pitch        Pitch                    @relation(fields: [pitchId], references: [id])
  participants BookingParticipant[]
  dueChanges   BookingDueChange[]

  @@index([tenantId])
}

/// Who is on a booking. The public requester is a row with isRequester (DR-002 §2.10).
model BookingParticipant {
  id           String    @id @default(cuid())
  tenantId     String
  bookingId    String
  /// Null while a per-player slot has no person yet. Callers that pass a phone still set it.
  /// A requester cannot be null:
  /// CHECK ("isRequester" = false OR "personId" IS NOT NULL) is SQL-only
  /// (BookingParticipant_requester_has_person).
  personId     String?
  /// CHECK ("amountDueUsd" >= 0) is SQL-only (BookingParticipant_amountDueUsd_nonneg).
  amountDueUsd Decimal   @db.Decimal(12, 2)
  /// 1-based share order for an even split. Null on WHOLE.
  /// At most one row per booking when set: partial unique
  /// BookingParticipant_bookingId_slotNumber_not_null_key
  /// ("bookingId", "slotNumber") WHERE "slotNumber" IS NOT NULL.
  /// Prisma cannot declare that WHERE. The plain index is @@index below.
  slotNumber   Int?
  /// At most one true row per booking. Enforced by SQL partial unique
  /// BookingParticipant_one_requester_idx ("bookingId") WHERE "isRequester" = true.
  /// Prisma cannot declare that WHERE.
  isRequester  Boolean
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  booking      Booking   @relation(fields: [bookingId], references: [id])
  person       Person?   @relation(fields: [personId], references: [id])
  allocations  PaymentAllocation[]

  @@index([tenantId])
  @@index([tenantId, personId])
  @@index([bookingId, slotNumber])
}

/// Waitlist window (DR-002 §2.13). Written on auto-reject (SPEC-05). No UI this slice.
model SlotInterest {
  id        String                   @id @default(cuid())
  tenantId  String
  pitchId   String
  /// Same tstzrange as Booking. Stores the *approved* window, not a rejected booking id.
  during    Unsupported("tstzrange")
  personId  String
  createdAt DateTime                 @default(now())
  tenant    Tenant                   @relation(fields: [tenantId], references: [id])
  pitch     Pitch                    @relation(fields: [pitchId], references: [id])
  person    Person                   @relation(fields: [personId], references: [id])

  @@index([tenantId])
}

/// DR-002 §2.8 / §2.12. PENDING may overlap; only APPROVED will hit the exclusion (step 2).
enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  OWNER
  PUBLIC
}

/// How a booking's USD due is owed (SPEC-15). Existing rows are WHOLE.
enum CollectionMode {
  WHOLE
  PER_PLAYER
}

/// Why Booking.amountDueUsd changed (SPEC-16). Append-only.
enum BookingDueReason {
  LATE_CANCELLATION_FEE
  NO_SHOW_FEE
  CANCELLATION_NO_FEE
  PARTIAL_GAME
  DISCOUNT
  WAIVER
  CORRECTION
}

/// One change of what is collectible. Never updated or deleted.
/// CHECK ("fromUsd" >= 0 AND "toUsd" >= 0) is SQL-only (BookingDueChange_usd_nonneg).
model BookingDueChange {
  id                String           @id @default(cuid())
  tenantId          String
  bookingId         String
  fromUsd           Decimal          @db.Decimal(12, 2)
  toUsd             Decimal          @db.Decimal(12, 2)
  reason            BookingDueReason
  note              String?
  actorMembershipId String
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  booking           Booking          @relation(fields: [bookingId], references: [id])
  actorMembership   Membership       @relation(fields: [actorMembershipId], references: [id])

  @@index([tenantId, bookingId])
}

/// Login account. No tenantId — memberships attach a user to a stadium (DR-003 §3).
model User {
  id            String           @id @default(cuid())
  identifier    String           @unique
  passwordHash  String
  createdAt     DateTime         @default(now())
  memberships   Membership[]
  sessions      Session[]
  personLinks   UserPersonLink[]
}

/// This user may work at this stadium. tenantId required (DR-001). Unique per tenant+user.
model Membership {
  id          String         @id @default(cuid())
  tenantId    String
  userId      String
  role        MembershipRole
  /// Zod-validated at the app edge (DR-003 §5). Default empty = staff has no extra flags.
  permissions Json           @default("{}")
  createdAt   DateTime       @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  dueChanges  BookingDueChange[]

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Server-side session. No tenantId — cookie is not the isolation key (DR-003 §4).
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Optional account↔person. Empty this slice (DR-002 §2.1 / DR-003 §6). tenantId required.
model UserPersonLink {
  id        String             @id @default(cuid())
  tenantId  String
  userId    String
  personId  String
  relation  PersonLinkRelation
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  user      User               @relation(fields: [userId], references: [id])
  person    Person             @relation(fields: [personId], references: [id])

  @@index([tenantId])
}

enum MembershipRole {
  OWNER
  STAFF
}

enum PersonLinkRelation {
  SELF
  GUARDIAN
}

/// Current and past LBP-per-USD rates. Append-only (DR-002 §2.17). tenantId required.
model ExchangeRate {
  id        String   @id @default(cuid())
  tenantId  String
  lbpPerUsd Decimal  @db.Decimal(18, 0)
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// One collection event. Links to a booking by sourceType+sourceId — no booking_id (DR-002 §2.14).
model Payment {
  id           String            @id @default(cuid())
  tenantId     String
  sourceType   PaymentSourceType
  sourceId     String
  /// Booking: Booking.amountDueUsd at collection. Expense: this payment’s USD-equivalent sum (SPEC-06 / SPEC-07).
  amountDueUsd Decimal           @db.Decimal(12, 2)
  createdAt    DateTime          @default(now())
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  tenders      PaymentTender[]
  allocations  PaymentAllocation[]

  @@index([tenantId])
  @@index([sourceType, sourceId])
}

/// USD from one payment assigned to one participant. No person column on Payment (DR-002 §2.14).
/// CHECK ("amountUsd" > 0) is SQL-only (PaymentAllocation_amountUsd_positive).
model PaymentAllocation {
  id            String             @id @default(cuid())
  tenantId      String
  paymentId     String
  participantId String
  amountUsd     Decimal            @db.Decimal(12, 2)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment       Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  participant   BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@index([participantId])
  @@unique([paymentId, participantId])
}

/// One cash part of a payment. amount is Decimal(18,2); domain enforces USD cents vs integer LBP (SPEC-06).
model PaymentTender {
  id            String   @id @default(cuid())
  tenantId      String
  paymentId     String
  currency      Currency
  amount        Decimal   @db.Decimal(18, 2)
  /// Frozen rate. Null on USD when no rate existed (SPEC-06).
  rateAtTime    Decimal?  @db.Decimal(18, 0)
  usdEquivalent Decimal   @db.Decimal(12, 2)
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  payment       Payment   @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
}

/// USD movement, append-only. Same source as the payment; written in the same tx (DR-002 §2.21).
model LedgerEntry {
  id         String            @id @default(cuid())
  tenantId   String
  direction  LedgerDirection
  amountUsd  Decimal            @db.Decimal(12, 2)
  occurredAt DateTime          @default(now())
  sourceType PaymentSourceType
  sourceId   String
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, occurredAt])
}

/// What was spent. No amount — money is a Payment with sourceType EXPENSE (DR-002 §2.22).
model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  category    ExpenseCategory
  description String
  occurredAt  DateTime
  createdAt   DateTime        @default(now())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, occurredAt])
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  MAINTENANCE
  SALARY
  EQUIPMENT
  OTHER
}

/// Polymorphic source. BOOKING | EXPENSE (DR-002 §2.14). Shop later is additive.
enum PaymentSourceType {
  BOOKING
  EXPENSE
}

enum Currency {
  USD
  LBP
}

/// IN = collect; OUT = expense (SPEC-07). Append-only (DR-002 §2.21).
enum LedgerDirection {
  IN
  OUT
}
